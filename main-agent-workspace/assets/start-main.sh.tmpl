#!/usr/bin/env bash
# Usage: scripts/start-main.sh [codex args]
# Resume: scripts/start-main.sh resume --last
set -euo pipefail

SUBPROJECTS=(
  # "/abs/path/to/root"   # <name> (owner: <name>-owner)
)

MAIN_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$MAIN_DIR"
ARGS=()
for p in ${SUBPROJECTS[@]+"${SUBPROJECTS[@]}"}; do
  if [[ -d "$p" ]]; then
    ARGS+=(--add-dir "$p")
  else
    echo "warning: sub-project path not found, skipped: $p" >&2
  fi
done
# These flags are valid for both the normal CLI and the resume subcommand.
if [[ "${1:-}" == "resume" ]]; then
  shift
  exec codex resume --cd "$MAIN_DIR" ${ARGS[@]+"${ARGS[@]}"} "$@"
fi
exec codex --cd "$MAIN_DIR" ${ARGS[@]+"${ARGS[@]}"} "$@"
