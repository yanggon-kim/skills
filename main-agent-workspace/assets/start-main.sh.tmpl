#!/usr/bin/env bash
# Launch the MAIN agent session with directory access for every registered sub-project root.
# Adding a sub-project = one line in SUBPROJECTS (absolute path, comment naming its owner).
# Usage: scripts/start-main.sh [extra claude args...]    e.g.  scripts/start-main.sh --resume
set -euo pipefail

SUBPROJECTS=(
  # "/abs/path/to/root"   # <name> (owner: <name>-owner)
)

MAIN_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$MAIN_DIR"

ARGS=()
for p in ${SUBPROJECTS[@]+"${SUBPROJECTS[@]}"}; do
  if [[ -d "$p" ]]; then
    ARGS+=(--add-dir "$p")
  else
    echo "warning: sub-project path not found, skipped: $p" >&2
  fi
done

echo "main dir: $MAIN_DIR"
if ((${#SUBPROJECTS[@]})); then
  printf 'sub-projects:\n'; printf '  %s\n' "${SUBPROJECTS[@]}"
else
  echo "sub-projects: (none registered yet)"
fi

# ${arr[@]+"${arr[@]}"} keeps empty arrays safe under set -u on bash < 4.4 (macOS ships 3.2)
exec claude ${ARGS[@]+"${ARGS[@]}"} "$@"
